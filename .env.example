PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=accident_reporting
# Use a long random value. Never reuse this example text on a shared deployment.
JWT_SECRET=change_this_secret_key
JWT_EXPIRE=8h
UPLOAD_DIR=uploads
# Comma-separated browser origins allowed to call the API directly, or * to allow any.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
